    <string name="app_management_title">App management</string>
    <string name="app_management_description">Install and update prompts show up only when Android\'s installer screen appears, whichever app opened it. Silent installers that skip that screen, like the Play Store or adb, slip through. Uninstalls get caught deeper in the system server, so removing an app from the launcher, Settings, Play Store, or adb is blocked even without that screen. One approval clears that kind of action across every app and profile, then expires after a short while</string>
    <string name="app_management_install_title">Require biometric to install apps</string>
    <string name="app_management_install_summary">Protect APK installs and app updates before Android shows the installer</string>
    <string name="app_management_uninstall_title">Require biometric to uninstall apps</string>
    <string name="app_management_uninstall_summary">Protect app removals from the launcher, Settings, Play Store, and adb</string>

